                    <CellContents>
                      <Textbox Name="ล้าง1">
                        <CanGrow>true</CanGrow>
                        <KeepTogether>true</KeepTogether>
                        <Paragraphs>
                          <Paragraph>
                            <TextRuns>
                              <TextRun>
                                <Value>=Fields!ล้าง.Value</Value>
                                <Style>
