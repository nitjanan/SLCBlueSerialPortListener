<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <add name="SerialPortListener.Properties.Settings.truckConnectionString"
            connectionString="User Id=postgres;Password=postgres;Host=localhost;Database=truck;Character Set=UTF8;Initial Schema=public"
            providerName="Devart.Data.PostgreSql" />
        <add name="SerialPortListener.Properties.Settings.ConnectionString"
            connectionString="Dsn=PostgreSQLM" providerName="System.Data.Odbc" />
    </connectionStrings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
